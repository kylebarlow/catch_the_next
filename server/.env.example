TRANSITLAND_API_KEY=your_transitland_api_key_here
# Full-access keys (Play edition): nationwide stops via Transitland + 511 offload.
APP_API_KEYS=your-app-key-here,optional-second-key-here
# Public 511-only keys (F-Droid "Bay" edition). These are hard-scoped to local Bay Area /
# 511 data; any Transitland path is refused with 403 forbidden_upstream. The Bay edition ships
# this key committed in source (see phone/build.gradle.kts bayPublicApiKey) — keep them in sync.
APP_API_KEYS_PUBLIC=your-public-bay-key-here

# 511.org API token — required when FIVE_ELEVEN_ENABLED=1 (default on).
# Register at https://511.org/open-data/token to obtain.
FIVE_ELEVEN_API_KEY=your_511_api_key_here

# Optional overrides
# TRANSITLAND_BASE_URL=https://transit.land/api/v2/rest
# RATE_LIMIT_PER_HOUR=500
# ACCESS_LOG_PATH=/home/logs/access_log
# UPSTREAM_CONNECT_TIMEOUT=5
# UPSTREAM_READ_TIMEOUT=10
# FIVE_ELEVEN_BASE_URL=https://api.511.org/transit
# FIVE_ELEVEN_AGENCY=RG
# FIVE_ELEVEN_RT_TTL=60
# FIVE_ELEVEN_STATIC_TTL=604800
# FIVE_ELEVEN_ENABLED=1
# GTFS_511_DB_DIR=/home/protected/gtfs511
