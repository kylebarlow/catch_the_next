<?xml version="1.0" encoding="utf-8"?>
<!-- Bus with raked windshield + speed lines, sized to fit inside the 66dp safe-zone circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bus body: rounded back, slanted front windshield, two side windows + windshield cutouts -->
    <path
        android:fillColor="#1A3A5C"
        android:fillType="evenOdd"
        android:pathData="
            M 40,36 L 71,36 L 81,48 L 81,56 Q 81,59 78,59 L 40,59 Q 37,59 37,56 L 37,39 Q 37,36 40,36 Z
            M 40,39 H 48 V 51 H 40 Z
            M 51,39 H 59 V 51 H 51 Z
            M 62,39 L 69,39 L 79,51 L 62,51 Z" />

    <!-- Left wheel -->
    <path
        android:fillColor="#1A3A5C"
        android:pathData="M 40,65 A 6,6 0 1 0 52,65 A 6,6 0 1 0 40,65 Z" />

    <!-- Right wheel -->
    <path
        android:fillColor="#1A3A5C"
        android:pathData="M 66,65 A 6,6 0 1 0 78,65 A 6,6 0 1 0 66,65 Z" />

    <!-- Speed lines: tapered, longest in the middle -->
    <path
        android:strokeColor="#1A3A5C"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M 27,42 L 33,42 M 23,49 L 33,49 M 26,56 L 33,56" />

</vector>
