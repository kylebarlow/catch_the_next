# Play upload signing for the phone `play` release variant. Copy to keystore.properties
# (gitignored) and fill in. The keystore file itself must NEVER be committed.
#
# Generate an upload keystore once:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
#
# Then enroll in Play App Signing (Google manages the app signing key; you keep the upload key).
storeFile=upload-keystore.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
